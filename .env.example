# --- Ports ---
WEB_PORT=3000
STRAPI_PORT=1337
POSTGRES_PORT=5432

# --- Database (persistent volume: forma-postgres-data) ---
POSTGRES_USER=forma
POSTGRES_PASSWORD=forma_password
POSTGRES_DB=forma

# --- Strapi ---
# When running with `docker compose --profile cms up`, web uses this URL internally:
STRAPI_URL=http://strapi:1337
# When Strapi runs outside Docker (npm run develop), use:
# STRAPI_URL=http://host.docker.internal:1337
# STRAPI_URL=http://localhost:1337

# Generate secrets: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret
ADMIN_JWT_SECRET=change-me-admin-jwt
APP_KEYS=change-me-app-key-1,change-me-app-key-2
API_TOKEN_SALT=change-me-salt
TRANSFER_TOKEN_SALT=change-me-transfer-salt
ENCRYPTION_KEY=change-me-encryption-key

# --- Supabase (plugmzcqdxyzptpscqxy) ---
SUPABASE_URL=https://plugmzcqdxyzptpscqxy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://plugmzcqdxyzptpscqxy.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=plugmzcqdxyzptpscqxy
# Supabase Postgres — get from Supabase Dashboard → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.plugmzcqdxyzptpscqxy.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://plugmzcqdxyzptpscqxy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
